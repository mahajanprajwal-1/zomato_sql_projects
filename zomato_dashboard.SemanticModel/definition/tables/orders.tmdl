table orders
	lineageTag: 79de8254-5583-4956-8fec-33a61ac08432

	/// Distinct count of orders placed.
	measure 'Total Orders' = DISTINCTCOUNT(orders[order_id])
		formatString: #,0
		displayFolder: Key Measures
		lineageTag: 37d80cbc-9a14-48de-9d18-9f059986b87f

	/// Sum of order value (total_amount) in INR.
	measure 'Total Revenue' = SUM(orders[total_amount])
		formatString: "₹"#,0
		displayFolder: Key Measures
		lineageTag: 18263768-362d-4aab-8911-d17efa53494e

	/// Total Revenue divided by Total Orders.
	measure 'Avg Order Value' = DIVIDE([Total Revenue], [Total Orders])
		formatString: "₹"#,0.00
		displayFolder: Key Measures
		lineageTag: 9ede6b53-e65b-4dc2-80be-ecac81588f49

	/// Number of deliveries with status = Delivered.
	measure 'Delivered Orders' = CALCULATE(COUNTROWS(deliveries), deliveries[delivery_status] = "Delivered")
		formatString: #,0
		displayFolder: Delivery Measures
		lineageTag: 057901eb-84d2-40e5-b73a-b74dd09488b5

	/// Delivered Orders as a share of all deliveries.
	measure 'Delivery Success %' = DIVIDE([Delivered Orders], COUNTROWS(deliveries))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Delivery Measures
		lineageTag: a0f01c97-bb67-4cb7-922f-a6d84c0df2b2

